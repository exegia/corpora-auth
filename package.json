{
  "name": "corpora-auth-workspace",
  "private": true,
  "workspaces": [
    "guest-js",
    "ui",
    "examples/*-app"
  ],
  "catalog": {
    "@base-ui/react": "^1.6.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "catalogs": {
    "build": {
      "@tailwindcss/vite": "^4.3.3",
      "@vitejs/plugin-react": "^6.0.4",
      "typescript": "^7.0.2"
    },
    "testing": {
      "@testing-library/jest-dom": "^7.0.0",
      "@testing-library/react": "^16.3.2",
      "@testing-library/user-event": "^14.6.1",
      "jsdom": "^30.0.0",
      "vitest": "^4.1.10",
      "vitest-axe": "^0.1.0"
    }
  },
  "scripts": {
    "build": "bun run --filter @exegia/plugin-supabase-auth build && bun run --filter @exegia/auth-ui build && bun run --filter tauri-app build",
    "test": "bun run --filter '*' test",
    "test:e2e": "cargo test --test e2e_lifecycle -- --ignored --nocapture"
  },
  "packageManager": "bun@1.3.2"
}
