        "groups": [
          {
            "group": "Setup",
            "pages": [
              "plugin/installation",
              "plugin/configuration",
              "plugin/permissions",
              "plugin/provider-setup"
            ]
          },
          {
            "group": "API",
            "pages": [
              "plugin/javascript-api",
              "plugin/rust-api",
              "plugin/errors"
            ]
          },
          {
            "group": "Flows",
            "pages": [
              "plugin/oauth",
              "plugin/passkeys"
            ]
          }
        ]
      },
