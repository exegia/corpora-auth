{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": []
  },
  "tsc-alias": {
    "resolveFullPaths": true
  },
  "exclude": ["src/test", "src/**/__tests__", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
