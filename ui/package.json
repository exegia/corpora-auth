{
  "name": "@exegia/auth-ui",
  "version": "0.5.0",
  "description": "Authentication UI kit (coss ui components and blocks) for tauri-plugin-supabase-auth",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./blocks/*": "./src/blocks/*",
    "./components/*": "./src/components/*",
    "./hooks/*": "./src/hooks/*",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && cp src/styles.css dist/styles.css && mkdir -p dist/fonts && cp src/fonts/CalSansVF.woff2 src/fonts/OFL.txt dist/fonts/",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@exegia/plugin-supabase-auth": "workspace:*",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "tailwind-merge": "catalog:",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:build",
    "@testing-library/jest-dom": "catalog:testing",
    "@testing-library/react": "catalog:testing",
    "@testing-library/user-event": "catalog:testing",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:build",
    "jsdom": "catalog:testing",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:build",
    "vitest": "catalog:testing",
    "vitest-axe": "catalog:testing",
    "tsc-alias": "^1.9.1"
  },
  "license": "MIT OR Apache-2.0",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exegia/corpora-auth.git",
    "directory": "ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css"
    }
  }
}
